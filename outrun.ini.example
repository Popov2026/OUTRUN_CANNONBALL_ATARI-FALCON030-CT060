# outrun.ini.example - every run-time option of the Atari port, with its default value.
# Copy it to outrun.ini, next to the program, and change what you want. Read once when the game starts.
# Every line is optional: a missing line keeps the default given in its description.
# Everything after '#' or ';' on a line is a comment.

# ---- Picture -----------------------------------------------------------------------------

shadows      = 1     # 1 = draw the shadows under the cars and the scenery (default).
                     # 0 = no shadows: a little faster (about +4 % pictures per second).

shadow_min_z = 0     # With shadows = 1, only objects at least this near get a shadow.
                     # 0 = all of them (default), 0x100 = only the nearest ones. Range 0..0x1ff.

scenery      = 1     # 1 = roadside scenery drawn: trees, signs, buildings, rocks (default).
                     # 0 = only the road, the traffic and your car, with the sky and the HUD.
                     # The objects are not created at all, so there is nothing to crash into
                     # beside the road. By far the biggest speed-up: meant for the 68030.

vscale       = 100   # Share of the 224 lines that is computed, in percent. Range 50..100.
                     # 100 = every line (default). 67 = two lines out of three, the third repeats
                     # the one above (about +17 % pictures per second). 50 = every other line
                     # (about +26 %).

road_hres    = 0     # 0 = road drawn in full detail (default).
                     # 1 = every other column of the road texture is used and drawn twice: the
                     # dashes and edges are a little chunkier. Sprites, sky and text unaffected.

cadence      = 0     # How many game steps (1/30 s each) go by between two pictures.
                     # 0 = automatic, the game picks what the machine can hold (default).
                     # 1 = 30 pictures per second, 2 = 15, 3 = 10, 4 = 7.5.

# ---- Sound -------------------------------------------------------------------------------

sound        = 2     # 0 = no sound at all.
                     # 1 = sound always synthesised.
                     # 2 = sound synthesised only when the machine has time left (default if this
                     #     line is missing).

music        = 1     # 1 = music on (default). 0 = no music; sound effects are not affected.

fm_half      = 0     # Only matters for the original FM music (mod = 0), with fm_dsp = 0.
                     # 0 = FM chip synthesised at the full rate (default).
                     # 1 = at half rate: cheaper (13.5 ms per game step instead of 18.6 on a
                     # 68060) but the FM sounds duller.

sound_irq    = 2     # 1 = the sound is made from a timer interrupt, whenever the sound hardware
                     # needs it: the music keeps its tempo and has no holes even when the game
                     # runs slower than real time.
                     # 0 = one step of sound per game step: when the game is slower than real
                     # time, the sound comes out in pieces.
                     # 2 = 1 with a 68040/68060, 0 with a 68030 (default). A 16 MHz 68030 needs
                     # more than all its time for the sound alone, so the interrupt would leave
                     # nothing for the game.

fm_dsp       = 1     # 1 = the FM music and sounds are computed by the Falcon's DSP (default): the
                     # same sound as the processor would make, for a fraction of its time - on a
                     # 68030 the FM music alone needs far more than the processor has. The FM sound
                     # (and with it the PCM sound) is heard one game step (1/30 s) later.
                     # While a .mod is played on the DSP (mod = 1 with mod_dsp = 1 or 2), the FM
                     # goes back to the processor. Falls back to 0 by itself without a DSP.
                     # 0 = always computed by the processor.

mod          = 0     # 0 = original FM music (default if this line is missing).
                     # 1 = music played from the .mod files in the Music folder: TRACK1.MOD =
                     # Magical Sound Shower, TRACK2.MOD = Passing Breeze, TRACK3.MOD = Splash Wave,
                     # TRACK4.MOD = Last Wave (high-score screen). A missing file falls back to the
                     # FM track. Much lighter on the processor than the FM music. Needs music = 1.

mod_dsp      = 0     # Only matters with mod = 1.
                     # 2 = played by DSPMOD 3.4 (bITmASTER of TCE) on the DSP, the game's sound
                     #     effects going through two of its effect voices. 4-voice modules.
                     #     Modules with more than 64 patterns, and all modules with a 68040/68060
                     #     (DSPMOD is not safe on it), are played as with mod_dsp = 1.
                     # 0 = the .mod music is mixed by the processor (default if this line is
                     #     missing).
                     # 1 = it is played by the Falcon's DSP: 49 kHz stereo, steady tempo whatever
                     #     the picture rate. Falls back to 0 by itself if the DSP does not answer.
                     #     Set it to 0 if the sound misbehaves.

# ---- Files -------------------------------------------------------------------------------

freemint     = 1     # 1 = the ROM files keep their original long names such as "epr-10380b.133":
                     #     needs FreeMiNT or another system with long file names (default).
                     # 0 = look for the same files renamed to 8.3 names instead (the table of
                     #     names is in README_ATARI.md): works on plain TOS.

# ---- Joystick ----------------------------------------------------------------------------

joy_accel    = up+b  # What accelerates, what brakes and what changes gear with a joystick or pad.
joy_brake    = down+c # Each line takes one or more of these words, joined with '+':
joy_gear     = fire  #   up, down = the stick; fire = the button of a DB9 joystick or button A of
                     #   a Jaguar pad; b, c = buttons B and C of a Jaguar pad; none = nothing.
                     # Default: stick forward accelerates, back brakes, fire changes gear.
                     # Example, fire to accelerate: joy_accel = fire, joy_brake = down,
                     # joy_gear = up. Left/right always steer; the keyboard always works too.
